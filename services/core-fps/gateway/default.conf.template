map $arg_ticket $core_ticket {
  default $arg_ticket;
  "" $cookie_core_fps_ticket;
}

map $arg_ticket $core_ticket_cookie {
  ~.+ "core_fps_ticket=$arg_ticket; Path=/; Max-Age=7200; HttpOnly; Secure; SameSite=Strict";
  default "";
}

map $arg_cmd $core_launch_redirect {
  default "/?cmd=$arg_cmd";
  "" "/";
}

server {
  listen 8080;
  server_name _;

  absolute_redirect off;
  client_max_body_size 2m;

  add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self' data:; frame-ancestors ${CORE_FPS_PARENT_ORIGIN}; img-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'; script-src 'self' 'unsafe-eval' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:" always;
  add_header Cross-Origin-Resource-Policy "cross-origin" always;
  add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Set-Cookie $core_ticket_cookie always;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location = /_core_auth {
    internal;
    proxy_pass http://${CORE_FPS_APP_UPSTREAM}/api/internal/games/core/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Core-Gateway-Secret "${CORE_FPS_GATEWAY_SHARED_SECRET}";
    proxy_set_header X-Core-Ticket $core_ticket;
  }

  location ^~ /service/proxy/ {
    return 404;
  }

  location = / {
    access_log off;

    if ($arg_ticket != "") {
      return 302 $core_launch_redirect;
    }

    auth_request /_core_auth;
    proxy_pass http://${CORE_FPS_RUNTIME_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /ws/ {
    auth_request /_core_auth;
    auth_request_set $core_display_name $upstream_http_x_core_display_name;
    auth_request_set $core_player_name $upstream_http_x_core_player_name;
    auth_request_set $core_session_id $upstream_http_x_core_session_id;
    auth_request_set $core_user_id $upstream_http_x_core_user_id;
    proxy_pass http://${CORE_FPS_WEBSOCKET_UPSTREAM};
    proxy_http_version 1.1;
    proxy_read_timeout 24h;
    proxy_send_timeout 30s;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header X-Core-Display-Name $core_display_name;
    proxy_set_header X-Core-Player-Name $core_player_name;
    proxy_set_header X-Core-Session-Id $core_session_id;
    proxy_set_header X-Core-User-Id $core_user_id;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /api/ {
    auth_request /_core_auth;
    proxy_pass http://${CORE_FPS_RUNTIME_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Sour v0.2.5 leaves interrupted asset promises and closed cluster sockets
  # pending forever. These pinned compatibility shims provide retry/reconnect
  # behavior until the fixes are included in a published runtime.
  location = /index.js {
    auth_request /_core_auth;
    proxy_pass http://${CORE_FPS_RUNTIME_UPSTREAM};
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Accept-Encoding "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    sub_filter_types application/javascript text/javascript;
    sub_filter_once on;
    sub_filter 's.onopen=()=>{const{current:e}=l;' 's.onopen=()=>{sessionStorage.removeItem("coreWsRetry");const{current:e}=l;';
    sub_filter 'i.current=s;const c=' 'i.current=s,s.onclose=()=>{const e=Math.min(3e4,1500*Math.pow(2,Number(sessionStorage.getItem("coreWsRetry")||0)));sessionStorage.setItem("coreWsRetry",String(Number(sessionStorage.getItem("coreWsRetry")||0)+1));const t=()=>location.reload();"hidden"===document.visibilityState?document.addEventListener("visibilitychange",(()=>{"visible"===document.visibilityState&&t()}),{once:!0}):setTimeout(t,e)},s.onerror=()=>s.close();const c=';
  }

  location = /worker.f7ebc54e.js {
    auth_request /_core_auth;
    proxy_pass http://${CORE_FPS_RUNTIME_UPSTREAM};
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Accept-Encoding "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    sub_filter_types application/javascript text/javascript;
    sub_filter_once on;
    sub_filter 'async function fn(t,n){const e=new XMLHttpRequest;return e.open("GET",t,!0),e.responseType="arraybuffer",e.onprogress=t=>{t.lengthComputable&&n(Q.downloading({downloadedBytes:t.loaded,totalBytes:t.total}))},e.onerror=function(n){throw new un("NetworkError for: "+t)},new Promise(((t,n)=>{e.onload=function(n){if(!(200==e.status||304==e.status||206==e.status||0==e.status&&e.response))throw new un(e.statusText+" : "+e.responseURL);t(e.response)},e.send(null)}))}' 'async function fn(t,n){for(let r=0;;r++)try{return await new Promise(((r,o)=>{const e=new XMLHttpRequest,i=()=>o(new un("NetworkError for: "+t));e.open("GET",t,!0),e.responseType="arraybuffer",e.onprogress=t=>{t.lengthComputable&&n(Q.downloading({downloadedBytes:t.loaded,totalBytes:t.total}))},e.onerror=i,e.onabort=i,e.onload=()=>{200==e.status||304==e.status||206==e.status||0==e.status&&e.response?r(e.response):o(new un(e.statusText+" : "+e.responseURL))},e.send(null)}))}catch(e){await new Promise((t=>setTimeout(t,Math.min(1e4,1e3*(r+1)))))} }';
  }

  location / {
    auth_request /_core_auth;
    proxy_pass http://${CORE_FPS_RUNTIME_UPSTREAM};
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
