+func (cm *ClientManager) AddBot(ownerCN uint32) *Client {
+	cm.mutex.Lock()
+	defer cm.mutex.Unlock()
+
+	taken := make(map[uint32]struct{})
+	for _, client := range cm.clients {
+		taken[client.CN] = struct{}{}
+	}
+
+	var cn uint32 = 128
+	for {
+		if _, ok := taken[cn]; !ok {
+			break
+		}
+		cn++
+	}
+
+	bot := NewClient(cn, 0, nil)
+	bot.IsBot = true
+	bot.Joined = true
+	bot.OwnerCN = ownerCN
+	bot.Skill = 88
+	cm.clients = append(cm.clients, bot)
+	return bot
+}
+
