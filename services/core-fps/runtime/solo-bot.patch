diff --git a/client/src/GameHud.tsx b/client/src/GameHud.tsx
new file mode 100644
index 0000000..19e6433
--- /dev/null
+++ b/client/src/GameHud.tsx
@@ -0,0 +1,269 @@
+import styled from '@emotion/styled'
+import * as React from 'react'
+
+import SAW_ICON from 'url:./static/saw.png'
+import SHOTGUN_ICON from 'url:./static/shotgun.png'
+import CHAINGUN_ICON from 'url:./static/machinegun.png'
+import ROCKET_ICON from 'url:./static/rocket.png'
+import RIFLE_ICON from 'url:./static/rifle.png'
+import GRENADE_ICON from 'url:./static/grenade.png'
+import PISTOL_ICON from 'url:./static/pistol.png'
+
+import type { PlayerState } from './types'
+import { WeaponType } from './types'
+
+const WEAPONS = [
+  { type: WeaponType.Saw, icon: SAW_ICON, name: 'Saw' },
+  { type: WeaponType.Shotgun, icon: SHOTGUN_ICON, name: 'Shotgun' },
+  { type: WeaponType.Chaingun, icon: CHAINGUN_ICON, name: 'Chaingun' },
+  { type: WeaponType.Rocket, icon: ROCKET_ICON, name: 'Rocket' },
+  { type: WeaponType.Rifle, icon: RIFLE_ICON, name: 'Rifle' },
+  { type: WeaponType.Grenade, icon: GRENADE_ICON, name: 'Grenade' },
+  { type: WeaponType.Pistol, icon: PISTOL_ICON, name: 'Pistol' },
+]
+
+const HudShell = styled.div<{ compact: boolean }>`
+  position: absolute;
+  z-index: 3;
+  left: 50%;
+  bottom: max(12px, env(safe-area-inset-bottom));
+  width: min(760px, calc(100% - 24px));
+  min-height: 64px;
+  transform: translateX(-50%);
+  display: grid;
+  grid-template-columns: minmax(150px, 0.85fr) minmax(160px, 0.7fr) minmax(
+      280px,
+      1.4fr
+    );
+  gap: 8px;
+  align-items: stretch;
+  color: #f7fbff;
+  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
+    sans-serif;
+  pointer-events: none;
+  user-select: none;
+  filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.55));
+
+  ${(props) =>
+    props.compact
+      ? `
+    top: max(8px, env(safe-area-inset-top));
+    bottom: auto;
+    width: min(390px, calc(100% - 120px));
+    min-height: 44px;
+    grid-template-columns: minmax(130px, 1fr) minmax(130px, 1fr);
+    gap: 6px;
+  `
+      : ''}
+
+  @media (prefers-reduced-motion: reduce) {
+    * {
+      transition: none !important;
+    }
+  }
+`
+
+const Panel = styled.div`
+  min-width: 0;
+  border: 1px solid rgba(135, 156, 194, 0.38);
+  border-radius: 6px;
+  background: rgba(4, 7, 14, 0.86);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
+  backdrop-filter: blur(10px);
+`
+
+const HealthPanel = styled(Panel)`
+  padding: 9px 11px;
+`
+
+const StatRow = styled.div`
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 8px;
+`
+
+const Label = styled.span`
+  overflow: hidden;
+  color: #aebbd1;
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: 0;
+  line-height: 1;
+  text-overflow: ellipsis;
+  text-transform: uppercase;
+  white-space: nowrap;
+`
+
+const Value = styled.strong`
+  color: #ffffff;
+  font-size: 20px;
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+`
+
+const HealthTrack = styled.div`
+  height: 8px;
+  margin-top: 8px;
+  overflow: hidden;
+  border: 1px solid rgba(255, 255, 255, 0.16);
+  border-radius: 3px;
+  background: #151923;
+`
+
+const HealthFill = styled.div<{ critical: boolean }>`
+  height: 100%;
+  border-radius: 2px;
+  background: ${(props) => (props.critical ? '#ff3d8f' : '#a6ff00')};
+  box-shadow: 0 0 12px
+    ${(props) =>
+      props.critical ? 'rgba(255, 61, 143, 0.55)' : 'rgba(166, 255, 0, 0.45)'};
+  transition: width 180ms ease-out, background-color 180ms ease-out;
+`
+
+const WeaponPanel = styled(Panel)`
+  display: grid;
+  grid-template-columns: 38px minmax(0, 1fr) auto;
+  gap: 8px;
+  align-items: center;
+  padding: 7px 10px;
+`
+
+const WeaponImage = styled.img`
+  width: 34px;
+  height: 34px;
+  object-fit: contain;
+  filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.65));
+`
+
+const WeaponName = styled.strong`
+  display: block;
+  overflow: hidden;
+  margin-top: 3px;
+  color: #ffffff;
+  font-size: 12px;
+  line-height: 1;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+`
+
+const AmmoValue = styled.strong`
+  color: #00d5ff;
+  font-size: 24px;
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+  text-shadow: 0 0 12px rgba(0, 213, 255, 0.45);
+`
+
+const WeaponRail = styled(Panel)`
+  display: grid;
+  grid-template-columns: repeat(7, minmax(34px, 1fr));
+  gap: 4px;
+  align-items: center;
+  padding: 6px;
+`
+
+const WeaponSlot = styled.div<{ disabled: boolean; selected: boolean }>`
+  position: relative;
+  display: grid;
+  min-width: 0;
+  height: 48px;
+  place-items: center;
+  border: 1px solid
+    ${(props) =>
+      props.selected ? 'rgba(255, 61, 143, 0.9)' : 'rgba(135, 156, 194, 0.2)'};
+  border-radius: 5px;
+  background: ${(props) =>
+    props.selected ? 'rgba(255, 61, 143, 0.14)' : 'rgba(255, 255, 255, 0.03)'};
+  opacity: ${(props) => (props.disabled ? 0.38 : 1)};
+  box-shadow: ${(props) =>
+    props.selected ? 'inset 0 -2px 0 #ff3d8f' : 'none'};
+
+  img {
+    width: 25px;
+    height: 25px;
+    object-fit: contain;
+  }
+
+  span {
+    position: absolute;
+    right: 3px;
+    bottom: 2px;
+    color: #ffffff;
+    font-size: 8px;
+    font-weight: 900;
+    font-variant-numeric: tabular-nums;
+    line-height: 1;
+  }
+`
+
+export default function GameHud(props: {
+  compact: boolean
+  isRunning: boolean
+  playerState: PlayerState
+}) {
+  const { compact, isRunning, playerState } = props
+
+  if (!isRunning) {
+    return null
+  }
+
+  const maxHealth = Math.max(1, playerState.maxHealth)
+  const health = Math.max(0, playerState.health)
+  const healthPercent = Math.min(100, Math.round((health / maxHealth) * 100))
+  const currentWeapon =
+    WEAPONS.find((weapon) => weapon.type === playerState.weapon) ??
+    WEAPONS[WEAPONS.length - 1]
+  const currentAmmo = playerState.ammo[currentWeapon.type] ?? 0
+
+  return (
+    <HudShell
+      aria-label="Player status"
+      compact={compact}
+      role="status"
+    >
+      <HealthPanel>
+        <StatRow>
+          <Label>{health > 0 ? 'Health' : 'Respawning'}</Label>
+          <Value>{health}</Value>
+        </StatRow>
+        <HealthTrack aria-hidden="true">
+          <HealthFill
+            critical={healthPercent <= 30}
+            style={{ width: `${healthPercent}%` }}
+          />
+        </HealthTrack>
+      </HealthPanel>
+
+      <WeaponPanel>
+        <WeaponImage alt="" aria-hidden="true" src={currentWeapon.icon} />
+        <span>
+          <Label>Equipped</Label>
+          <WeaponName>{currentWeapon.name}</WeaponName>
+        </span>
+        <AmmoValue aria-label={`${currentAmmo} ammunition`}>
+          {currentAmmo}
+        </AmmoValue>
+      </WeaponPanel>
+
+      {!compact ? (
+        <WeaponRail aria-label="Weapon ammunition">
+          {WEAPONS.map((weapon) => {
+            const ammo = playerState.ammo[weapon.type] ?? 0
+            return (
+              <WeaponSlot
+                disabled={ammo <= 0}
+                key={weapon.type}
+                selected={weapon.type === playerState.weapon}
+                title={`${weapon.name}: ${ammo}`}
+              >
+                <img alt="" aria-hidden="true" src={weapon.icon} />
+                <span>{ammo}</span>
+              </WeaponSlot>
+            )
+          })}
+        </WeaponRail>
+      ) : null}
+    </HudShell>
+  )
+}
