diff --git a/pkg/gameserver/relay/relay_test.go b/pkg/gameserver/relay/relay_test.go
new file mode 100644
index 0000000..601f6fa
--- /dev/null
+++ b/pkg/gameserver/relay/relay_test.go
@@ -0,0 +1,66 @@
+package relay
+
+import (
+	"testing"
+	"time"
+
+	"github.com/cfoust/sour/pkg/game/protocol"
+)
+
+type deliveredPacket struct {
+	channel uint8
+	payload []protocol.Message
+}
+
+func receivePacket(t *testing.T, packets <-chan deliveredPacket) deliveredPacket {
+	t.Helper()
+
+	select {
+	case packet := <-packets:
+		return packet
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("timed out waiting for relayed bot packet")
+		return deliveredPacket{}
+	}
+}
+
+func TestOwnedClientPacketsReachObserversButDoNotEchoToOwner(t *testing.T) {
+	relay := New()
+	ownerPackets := make(chan deliveredPacket, 4)
+	observerPackets := make(chan deliveredPacket, 4)
+	sendTo := func(destination chan<- deliveredPacket) sendFunc {
+		return func(channel uint8, payload []protocol.Message) {
+			destination <- deliveredPacket{channel: channel, payload: payload}
+		}
+	}
+
+	relay.AddClient(1, sendTo(ownerPackets))
+	relay.AddClient(2, sendTo(observerPackets))
+	botPositions, botPackets := relay.AddOwnedClient(128, 1, func(uint8, []protocol.Message) {})
+
+	botPositions.Publish(protocol.Pos{Client: 128})
+	position := receivePacket(t, observerPackets)
+	if position.channel != 0 || len(position.payload) != 1 {
+		t.Fatalf("unexpected bot position relay: %#v", position)
+	}
+	if message, ok := position.payload[0].(protocol.Pos); !ok || message.Client != 128 {
+		t.Fatalf("observer did not receive the owned bot position: %#v", position.payload)
+	}
+
+	botPackets.Publish(protocol.Text{Text: "bot combat packet"})
+	combat := receivePacket(t, observerPackets)
+	if combat.channel != 1 || len(combat.payload) != 2 {
+		t.Fatalf("unexpected bot combat relay: %#v", combat)
+	}
+	prefix, prefixOK := combat.payload[0].(protocol.ClientPacket)
+	message, messageOK := combat.payload[1].(protocol.Text)
+	if !prefixOK || prefix.Client != 128 || !messageOK || message.Text != "bot combat packet" {
+		t.Fatalf("observer did not receive the owned bot combat packet: %#v", combat.payload)
+	}
+
+	select {
+	case packet := <-ownerPackets:
+		t.Fatalf("owned bot packet was echoed to its controlling client: %#v", packet)
+	case <-time.After(40 * time.Millisecond):
+	}
+}
diff --git a/pkg/gameserver/solo_bot.go b/pkg/gameserver/solo_bot.go
new file mode 100644
index 0000000..fde102c
--- /dev/null
+++ b/pkg/gameserver/solo_bot.go
@@ -0,0 +1,155 @@
+package gameserver
+
+import (
+	"time"
+
+	P "github.com/cfoust/sour/pkg/game/protocol"
+	"github.com/cfoust/sour/pkg/gameserver/game"
+	"github.com/cfoust/sour/pkg/gameserver/protocol/disconnectreason"
+	"github.com/cfoust/sour/pkg/gameserver/protocol/playerstate"
+)
+
+const soloBotRespawnDelay = 1500 * time.Millisecond
+
+func (s *Server) resolvePacketClient(sender *Client, requestedCN int32) *Client {
+	if requestedCN < 0 || uint32(requestedCN) == sender.CN {
+		return sender
+	}
+
+	requested := s.Clients.GetClientByCN(uint32(requestedCN))
+	if requested == nil || !requested.IsBot || requested.OwnerCN != sender.CN {
+		return nil
+	}
+
+	return requested
+}
+
+func (s *Server) humanClients() []*Client {
+	humans := make([]*Client, 0, 2)
+	s.Clients.ForEach(func(client *Client) {
+		if client.Joined && !client.IsBot && client.State != playerstate.Spectator {
+			humans = append(humans, client)
+		}
+	})
+	return humans
+}
+
+func (s *Server) botClients() []*Client {
+	bots := make([]*Client, 0, 1)
+	s.Clients.ForEach(func(client *Client) {
+		if client.IsBot {
+			bots = append(bots, client)
+		}
+	})
+	return bots
+}
+
+func (s *Server) addSoloBot(owner *Client) {
+	bot := s.Clients.AddBot(owner.CN)
+	bot.server = s
+	bot.Name = "Bounce Bot"
+	bot.Model = int32(s.rng.Intn(6))
+	bot.State = playerstate.Dead
+
+	if teamedMode, ok := s.GameMode.(game.TeamMode); ok {
+		teamedMode.Join(&bot.Player)
+	}
+
+	s.Spawn(bot)
+	bot.State = playerstate.Alive
+	bot.LastSpawnAttempt = time.Time{}
+	bot.Positions, bot.Packets = s.relay.AddOwnedClient(bot.CN, owner.CN, func(uint8, []P.Message) {})
+	s.Broadcast(
+		P.InitAI{
+			Aiclientnum:    int32(bot.CN),
+			Ownerclientnum: int32(owner.CN),
+			Aitype:         1,
+			Aiskill:        bot.Skill,
+			Playermodel:    int32(bot.Model),
+			Name:           bot.Name,
+			Team:           bot.Team.Name,
+		},
+		P.SpawnState{
+			Client:      int32(bot.CN),
+			EntityState: bot.ToWire(),
+		},
+		P.ServerMessage{Text: "Bounce Bot joined while you wait for another player."},
+	)
+}
+
+func (s *Server) respawnDeadSoloBots(now time.Time) {
+	for _, bot := range s.botClients() {
+		if bot.State != playerstate.Dead ||
+			bot.LastDeath.IsZero() ||
+			now.Sub(bot.LastDeath) < soloBotRespawnDelay ||
+			!s.GameMode.CanSpawn(&bot.Player) {
+			continue
+		}
+
+		s.Spawn(bot)
+		bot.State = playerstate.Alive
+		bot.LastSpawnAttempt = time.Time{}
+		s.Broadcast(P.SpawnState{
+			Client:      int32(bot.CN),
+			EntityState: bot.ToWire(),
+		})
+	}
+}
+
+func (s *Server) removeBot(bot *Client) {
+	s.GameMode.Leave(&bot.Player)
+	s.Clock.Leave(&bot.Player)
+	s.Clients.Disconnect(bot, disconnectreason.None)
+	_ = s.relay.RemoveClient(bot.CN)
+}
+
+func (s *Server) removeBotsOwnedBy(ownerCN uint32) {
+	for _, bot := range s.botClients() {
+		if bot.OwnerCN == ownerCN {
+			s.removeBot(bot)
+		}
+	}
+}
+
+func (s *Server) consumeLobbyMapBootstrap(mapName string) (bool, bool) {
+	if !s.lobbyMapVoteOpen {
+		return false, s.lobbyMapName != "" && s.lobbyMapName == mapName
+	}
+
+	allowed := mapName == s.DefaultMap
+	for _, candidate := range s.Maps {
+		if candidate == mapName {
+			allowed = true
+			break
+		}
+	}
+	if !allowed {
+		return false, false
+	}
+
+	s.lobbyMapName = mapName
+	s.lobbyMapVoteOpen = false
+	return true, false
+}
+
+func (s *Server) reconcileSoloBot() {
+	humans := s.humanClients()
+	bots := s.botClients()
+
+	if len(humans) == 1 {
+		if len(bots) == 0 {
+			s.lobbyMapVoteOpen = true
+			s.addSoloBot(humans[0])
+		}
+		return
+	}
+
+	if len(humans) == 0 {
+		s.lobbyMapName = ""
+		s.lobbyMapVoteOpen = false
+	}
+
+	for _, bot := range bots {
+		s.removeBot(bot)
+	}
+}
diff --git a/pkg/gameserver/solo_bot_test.go b/pkg/gameserver/solo_bot_test.go
new file mode 100644
index 0000000..1d779fb
--- /dev/null
+++ b/pkg/gameserver/solo_bot_test.go
@@ -0,0 +1,40 @@
+package gameserver
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/cfoust/sour/pkg/gameserver/game"
+	"github.com/cfoust/sour/pkg/gameserver/protocol/playerstate"
+)
+
+func TestDeadSoloBotRespawnsAfterDelay(t *testing.T) {
+	server := New(context.Background(), &Config{})
+	server.GameMode = game.NewFFA(server)
+
+	bot := server.Clients.AddBot(0)
+	bot.server = server
+	bot.State = playerstate.Dead
+	bot.LastDeath = time.Now()
+	originalLifeSequence := bot.LifeSequence
+
+	server.respawnDeadSoloBots(bot.LastDeath.Add(soloBotRespawnDelay - time.Millisecond))
+	if bot.State != playerstate.Dead {
+		t.Fatal("bot respawned before the delay elapsed")
+	}
+
+	server.respawnDeadSoloBots(bot.LastDeath.Add(soloBotRespawnDelay + time.Millisecond))
+	if bot.State != playerstate.Alive {
+		t.Fatal("bot did not respawn after the delay elapsed")
+	}
+	if bot.LifeSequence == originalLifeSequence {
+		t.Fatal("bot respawn did not advance its life sequence")
+	}
+	if bot.Health != bot.MaxHealth {
+		t.Fatalf("bot respawn health = %d, want %d", bot.Health, bot.MaxHealth)
+	}
+	if !bot.LastSpawnAttempt.IsZero() {
+		t.Fatal("server-authoritative bot respawn left a spawn confirmation pending")
+	}
+}
