generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  pending
  suspended
  banned
}

enum AuditSeverity {
  info
  warning
  critical
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  displayName     String
  passwordHash    String?
  status          UserStatus       @default(pending)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         Profile?
  roles           UserRole[]
  authAccounts    AuthAccount[]
  authSessions    AuthSession[]
  streamKeys      StreamKey[]
  streamSchedules StreamSchedule[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  producerProfile ProducerProfile?
  orders          Order[]
  starPurchases   StarPurchase[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  group       String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String
  assignedById String?
  createdAt DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  slug      String   @unique
  bio       String?
  avatarUrl String?
  location  String?
  websiteUrl String?
  isPublic  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  severity  AuditSeverity @default(info)
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model StreamChannel {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  playbackUrl String?
  status      String          @default("offline")
  streamKeys  StreamKey[]
  sessions    StreamSession[]
  events      StreamEvent[]
  schedules   StreamSchedule[]
}

model StreamKey {
  id             String        @id @default(cuid())
  userId         String
  channelId      String?
  keyHash        String
  fingerprint    String        @unique
  status         String        @default("active")
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        StreamChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
}

model StreamSession {
  id        String        @id @default(cuid())
  channelId String
  startedAt DateTime
  endedAt   DateTime?
  peakViewers Int         @default(0)
  channel   StreamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model StreamEvent {
  id        String        @id @default(cuid())
  channelId String
  type      String
  payload   Json?
  createdAt DateTime      @default(now())
  channel   StreamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model StreamSchedule {
  id          String        @id @default(cuid())
  channelId   String
  hostUserId  String?
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      String        @default("scheduled")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  channel     StreamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  host        User?         @relation(fields: [hostUserId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([hostUserId])
  @@index([startsAt])
  @@index([status])
}

model ChatRoom {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  type      String        @default("public")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id              String   @id @default(cuid())
  roomId          String
  userId          String?
  body            String
  kind            String   @default("text")
  mediaUrl        String?
  mediaPreviewUrl String?
  mediaAlt        String?
  mediaSource     String?
  mediaSourceId   String?
  mediaWidth      Int?
  mediaHeight     Int?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  room            ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  status      String           @default("draft")
  variants    ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  name      String
  pricePence Int
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          String      @default("pending")
  totalPence      Int
  currency        String      @default("GBP")
  paypalOrderId   String?     @unique
  paypalCaptureId String?
  paypalPayerEmail String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productVariantId String?
  productName      String
  variantName      String
  sku              String
  quantity         Int
  unitPricePence   Int
  totalPence       Int
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
}

model ProducerProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  slug      String         @unique
  name      String
  bio       String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    DigitalTrack[]
}

model DigitalTrack {
  id          String          @id @default(cuid())
  producerId  String
  slug        String          @unique
  title       String
  genre       String?
  bpm         Int?
  musicalKey  String?
  pricePence  Int
  status      String          @default("draft")
  producer    ProducerProfile @relation(fields: [producerId], references: [id], onDelete: Cascade)
}

model StarWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model StarPurchase {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("pending")
  stars           Int
  totalPence      Int
  currency        String   @default("GBP")
  packageLabel    String
  paypalOrderId   String?  @unique
  paypalCaptureId String?
  paypalPayerEmail String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
