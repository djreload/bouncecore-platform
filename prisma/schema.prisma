generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  pending
  suspended
  banned
}

enum AuditSeverity {
  info
  warning
  critical
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  displayName     String
  passwordHash    String?
  status          UserStatus       @default(pending)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         Profile?
  roles           UserRole[]
  authAccounts    AuthAccount[]
  authSessions    AuthSession[]
  streamKeys      StreamKey[]
  streamSchedules StreamSchedule[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  chatReportsMade ChatReport[] @relation("ChatReportReporter")
  chatReportsTargeted ChatReport[] @relation("ChatReportTarget")
  chatReportsResolved ChatReport[] @relation("ChatReportResolver")
  chatBans        ChatBan[] @relation("ChatBanUser")
  chatBansCreated ChatBan[] @relation("ChatBanCreatedBy")
  chatBansRevoked ChatBan[] @relation("ChatBanRevokedBy")
  chatReactions   ChatReaction[]
  prizeClaims     PrizeClaim[] @relation("PrizeClaimUser")
  prizeClaimsResolved PrizeClaim[] @relation("PrizeClaimResolvedBy")
  invitesCreated  UserInvite[] @relation("UserInviteCreatedBy")
  invitesAccepted UserInvite[] @relation("UserInviteAcceptedBy")
  invitesRevoked  UserInvite[] @relation("UserInviteRevokedBy")
  producerProfile ProducerProfile?
  orders          Order[]
  starPurchases   StarPurchase[]
  starSends       StarSend[] @relation("StarSendUser")
  trackPurchases  DigitalTrackPurchase[]
  requestedPayoutBatches ProducerPayoutBatch[] @relation("ProducerPayoutBatchRequestedBy")
  mobileDevices   MobileDevice[]

  @@index([status])
  @@index([createdAt])
}

model MobileDevice {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  platform     String
  tokenHash    String   @unique
  tokenCiphertext String?
  tokenPreview String
  deviceName   String?
  appVersion   String?
  osVersion    String?
  lastSeenAt   DateTime @default(now())
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDeliveries MobilePushDelivery[]

  @@index([userId])
  @@index([provider])
  @@index([platform])
  @@index([tokenCiphertext])
  @@index([lastSeenAt])
  @@index([revokedAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  group       String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String
  assignedById String?
  createdAt DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  slug      String   @unique
  bio       String?
  avatarUrl String?
  location  String?
  websiteUrl String?
  isPublic  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model UserInvite {
  id           String   @id @default(cuid())
  email        String
  tokenHash    String   @unique
  roles        Json
  status       String   @default("pending")
  note         String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  revokedById  String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User     @relation("UserInviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy   User?    @relation("UserInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy    User?    @relation("UserInviteRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdById])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  severity  AuditSeverity @default(info)
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDeliveries MobilePushDelivery[]
}

model MobilePushDelivery {
  id             String       @id @default(cuid())
  notificationId String
  mobileDeviceId String
  provider       String
  platform       String
  status         String       @default("queued")
  providerMessageId String?
  errorCode      String?
  errorMessage   String?
  attemptedAt    DateTime?
  sentAt         DateTime?
  receiptStatus  String?
  receiptCheckedAt DateTime?
  providerReceipt Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  mobileDevice   MobileDevice @relation(fields: [mobileDeviceId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([mobileDeviceId])
  @@index([provider])
  @@index([platform])
  @@index([status])
  @@index([providerMessageId])
  @@index([sentAt])
  @@index([receiptStatus])
  @@index([receiptCheckedAt])
  @@index([createdAt])
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model StreamChannel {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  playbackUrl     String?
  offlineImageUrl String?
  status          String          @default("offline")
  streamProfileId String?
  streamProfile   StreamProfile?  @relation(fields: [streamProfileId], references: [id], onDelete: SetNull)
  streamKeys      StreamKey[]
  sessions        StreamSession[]
  events          StreamEvent[]
  schedules       StreamSchedule[]

  @@index([streamProfileId])
}

model StreamKey {
  id             String        @id @default(cuid())
  userId         String
  channelId      String?
  keyHash        String
  fingerprint    String        @unique
  status         String        @default("active")
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        StreamChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([channelId, status])
  @@index([keyHash])
  @@index([userId, status])
}

model StreamProfile {
  id                String          @id @default(cuid())
  key               String          @unique
  label             String
  description       String?
  videoWidth        Int
  videoHeight       Int
  videoBitrateKbps  Int
  audioBitrateKbps  Int
  fps               Int
  keyframeSeconds   Int             @default(2)
  isEnabled         Boolean         @default(true)
  isDefault         Boolean         @default(false)
  sortOrder         Int             @default(0)
  updatedAt         DateTime        @updatedAt
  createdAt         DateTime        @default(now())
  channels          StreamChannel[]

  @@index([isEnabled, sortOrder])
}

model StreamSession {
  id        String        @id @default(cuid())
  channelId String
  startedAt DateTime
  endedAt   DateTime?
  peakViewers Int         @default(0)
  channel   StreamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  starSends StarSend[]
}

model StreamEvent {
  id        String        @id @default(cuid())
  channelId String
  type      String
  payload   Json?
  createdAt DateTime      @default(now())
  channel   StreamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model StreamSchedule {
  id          String        @id @default(cuid())
  channelId   String
  hostUserId  String?
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      String        @default("scheduled")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  channel     StreamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  host        User?         @relation(fields: [hostUserId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([hostUserId])
  @@index([startsAt])
  @@index([status])
}

model ChatRoom {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  type            String        @default("public")
  lockedAt        DateTime?
  slowModeSeconds Int           @default(0)
  messages        ChatMessage[]
  reports         ChatReport[]
  bans            ChatBan[]
  starSends       StarSend[]
  createdAt       DateTime      @default(now())
}

model ChatMessage {
  id              String   @id @default(cuid())
  roomId          String
  userId          String?
  body            String
  kind            String   @default("text")
  mediaUrl        String?
  mediaPreviewUrl String?
  mediaAlt        String?
  mediaSource     String?
  mediaSourceId   String?
  mediaWidth      Int?
  mediaHeight     Int?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  room            ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reports         ChatReport[]
  starSend        StarSend?
  reactions       ChatReaction[]
}

model ChatStickerPack {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  status      String        @default("active")
  sortOrder   Int           @default(0)
  stickers    ChatSticker[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model ChatSticker {
  id         String          @id @default(cuid())
  packId     String
  name       String
  shortcode  String          @unique
  imageUrl   String
  kind       String          @default("sticker")
  isAnimated Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  pack       ChatStickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sortOrder])
  @@index([kind, sortOrder])
}

model ChatReaction {
  id          String      @id @default(cuid())
  messageId   String
  userId      String
  reactionKey String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId, reactionKey])
  @@index([userId])
}

model StarSend {
  id              String         @id @default(cuid())
  userId          String
  roomId          String
  messageId       String?        @unique
  streamSessionId String?
  amount          Int
  note            String?
  createdAt       DateTime       @default(now())
  user            User           @relation("StarSendUser", fields: [userId], references: [id], onDelete: Cascade)
  room            ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message         ChatMessage?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  streamSession   StreamSession? @relation(fields: [streamSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roomId])
  @@index([streamSessionId])
  @@index([createdAt])
}

model ChatReport {
  id                String       @id @default(cuid())
  messageId         String?
  reporterId        String?
  targetUserId      String?
  roomId            String?
  reason            String
  notes             String?
  status            String       @default("open")
  messageBody       String?
  messageKind       String?
  mediaPreviewUrl   String?
  targetDisplayName String?
  reporterDisplayName String?
  resolvedById      String?
  resolvedAt        DateTime?
  resolutionNote    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  message           ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporter          User?        @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUser        User?        @relation("ChatReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  room              ChatRoom?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  resolvedBy        User?        @relation("ChatReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([roomId])
  @@index([status])
  @@index([createdAt])
}

model ChatBan {
  id          String    @id @default(cuid())
  userId      String
  roomId      String?
  reason      String
  notes       String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("ChatBanUser", fields: [userId], references: [id], onDelete: Cascade)
  room        ChatRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("ChatBanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy   User?     @relation("ChatBanRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roomId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  imageUrl    String?
  status      String           @default("draft")
  variants    ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  name      String
  pricePence Int
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          String      @default("pending")
  totalPence      Int
  currency        String      @default("GBP")
  paypalOrderId   String?     @unique
  paypalCaptureId String?
  paypalPayerEmail String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productVariantId String?
  productName      String
  variantName      String
  sku              String
  quantity         Int
  unitPricePence   Int
  totalPence       Int
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
}

model ProducerProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  slug      String         @unique
  name      String
  bio       String?
  paypalPayoutEmail String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    DigitalTrack[]
  sales     DigitalTrackPurchase[]
  payouts   ProducerPayoutItem[]
}

model DigitalTrack {
  id          String          @id @default(cuid())
  producerId  String
  slug        String          @unique
  title       String
  genre       String?
  bpm         Int?
  musicalKey  String?
  artworkUrl   String?
  pricePence  Int
  previewUrl   String?
  downloadUrl  String?
  licenseType  String          @default("personal")
  licenseSummary String?
  status      String          @default("draft")
  producer    ProducerProfile @relation(fields: [producerId], references: [id], onDelete: Cascade)
  purchases   DigitalTrackPurchase[]
}

model DigitalTrackPurchase {
  id                    String          @id @default(cuid())
  buyerId               String
  trackId               String
  producerId            String
  status                String          @default("pending")
  trackTitle            String
  producerName          String
  downloadUrl           String?
  licenseType           String          @default("personal")
  licenseSummary        String?
  downloadCount         Int             @default(0)
  lastDownloadedAt      DateTime?
  pricePence            Int
  currency              String          @default("GBP")
  platformFeePence      Int             @default(0)
  producerEarningsPence Int
  paypalOrderId         String?         @unique
  paypalCaptureId       String?
  paypalPayerEmail      String?
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  buyer                 User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  track                 DigitalTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  producer              ProducerProfile @relation(fields: [producerId], references: [id], onDelete: Cascade)
  payoutItems           ProducerPayoutItem[]

  @@index([buyerId])
  @@index([trackId])
  @@index([producerId])
  @@index([status])
  @@index([createdAt])
}

model ProducerPayoutBatch {
  id                  String               @id @default(cuid())
  senderBatchId       String               @unique
  status              String               @default("pending")
  currency            String               @default("GBP")
  totalPence          Int
  itemCount           Int
  paypalPayoutBatchId String?              @unique
  paypalBatchStatus   String?
  paypalResponse      Json?
  errorMessage        String?
  requestedById       String?
  sentAt              DateTime?
  syncedAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  requestedBy         User?                @relation("ProducerPayoutBatchRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  items               ProducerPayoutItem[]

  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
}

model ProducerPayoutItem {
  id                      String               @id @default(cuid())
  batchId                 String
  purchaseId              String
  producerId              String
  recipientEmail          String
  amountPence             Int
  currency                String               @default("GBP")
  status                  String               @default("pending")
  senderItemId            String               @unique
  paypalPayoutItemId      String?              @unique
  paypalTransactionId     String?
  paypalTransactionStatus String?
  paypalFeePence          Int?
  errorMessage            String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  batch                   ProducerPayoutBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  purchase                DigitalTrackPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  producer                ProducerProfile      @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([purchaseId])
  @@index([producerId])
  @@index([status])
  @@index([createdAt])
}

model StarWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model StarPurchase {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("pending")
  stars           Int
  totalPence      Int
  currency        String   @default("GBP")
  packageLabel    String
  paypalOrderId   String?  @unique
  paypalCaptureId String?
  paypalPayerEmail String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model RewardSpinWheel {
  id              String                   @id @default(cuid())
  slug            String                   @unique
  name            String
  description     String?
  status          String                   @default("draft")
  costStars       Int                      @default(0)
  cooldownMinutes Int                      @default(1440)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  segments        RewardSpinWheelSegment[]
  prizeClaims     PrizeClaim[]

  @@index([status])
  @@index([createdAt])
}

model RewardSpinWheelSegment {
  id          String          @id @default(cuid())
  wheelId     String
  label       String
  prizeType   String          @default("none")
  prizeValue  String?
  starAmount  Int             @default(0)
  weight      Int             @default(1)
  status      String          @default("active")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  wheel       RewardSpinWheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  prizeClaims PrizeClaim[]

  @@index([wheelId])
  @@index([status])
}

model PrizeClaim {
  id             String                  @id @default(cuid())
  userId         String
  wheelId        String?
  segmentId      String?
  title          String
  description    String?
  status         String                  @default("pending")
  prizeType      String                  @default("manual")
  prizeValue     String?
  starAmount     Int                     @default(0)
  fulfilmentNote String?
  starsCreditedAt DateTime?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation("PrizeClaimUser", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy     User?                   @relation("PrizeClaimResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  wheel          RewardSpinWheel?        @relation(fields: [wheelId], references: [id], onDelete: SetNull)
  segment        RewardSpinWheelSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([wheelId])
  @@index([segmentId])
  @@index([status])
  @@index([createdAt])
}
