{
  "name": "bouncecore-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "stream-core": "tsx src/stream-core/server.ts",
    "worker": "tsx src/workers/main.ts",
    "lint": "eslint .",
    "test": "tsx tests/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "docker:build": "docker build -t bouncecore-platform:staging .",
    "readiness:report": "tsx scripts/readiness-report.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
    "smoke:auth": "node scripts/authenticated-smoke-check.mjs",
    "smoke:public": "node scripts/public-smoke-check.mjs",
    "smoke:payments:seed": "node scripts/seed-payment-smoke-fixture.mjs",
    "android:play-preflight": "powershell -ExecutionPolicy Bypass -File scripts/play-store-preflight.ps1",
    "stream:smoke": "powershell -ExecutionPolicy Bypass -File scripts/stream-smoke-test.ps1",
    "stream:smoke:temp-key": "powershell -ExecutionPolicy Bypass -File scripts/stream-smoke-with-temp-key.ps1",
    "stream:smoke:dual": "powershell -ExecutionPolicy Bypass -File scripts/stream-dual-smoke-test.ps1",
    "stream:smoke:dual-temp-keys": "powershell -ExecutionPolicy Bypass -File scripts/stream-dual-smoke-with-temp-keys.ps1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "hls.js": "^1.6.16",
    "lucide-react": "1.17.0",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "redis": "^6.0.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "hono": "4.12.27",
    "postcss": "8.5.16"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
